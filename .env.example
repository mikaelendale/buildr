APP_NAME=Buildr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Buildr
# ---------------------------------------------------------------------------
# Local dev runs on SQLite + the database queue/cache. Production (Laravel Cloud)
# uses Postgres + Redis: DB_CONNECTION=pgsql, QUEUE_CONNECTION=redis,
# CACHE_STORE=redis, SESSION_DRIVER=redis. See plan §1.1.

# Telegram bot (BotFather): account linking, password reset links and every
# notification (there is no mailer). Never used to read channels.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; register with: php artisan buildr:set-webhook
TELEGRAM_WEBHOOK_SECRET=
# Chat id that receives admin alerts (new submissions, reports, failures, budget).
TELEGRAM_ADMIN_CHAT_ID=
# Public support handle shown in the footer (without @).
BUILDR_SUPPORT_TELEGRAM=

# "Made by" credit in the public footer; defaults to the original author.
# BUILDR_MAKER_HANDLE=
# BUILDR_MAKER_URL=
# BUILDR_MAKER_TELEGRAM=
# BUILDR_MAKER_X=
# BUILDR_MAKER_GITHUB=
# BUILDR_MAKER_SUBSTACK=

# AI (Laravel AI SDK, config/ai.php)
AI_DEFAULT_PROVIDER=anthropic
BUILDR_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
BUILDR_AI_EXTRACTION_MODEL=claude-haiku-5-5
BUILDR_AI_SYNTHESIS_MODEL=claude-opus-5-5
BUILDR_AI_VERIFY_MODEL=claude-opus-5-5
BUILDR_AI_PROMPT_VERSION=1
BUILDR_AI_DAILY_BUDGET_USD=10
# "standard" for large-context paid models; "compact" trims every call to fit
# small per-minute token limits and paces requests (BUILDR_AI_TOKENS_PER_MINUTE).
BUILDR_AI_BUDGET_PROFILE=standard

# Groq free tier instead of Anthropic (8K tokens/minute):
# AI_DEFAULT_PROVIDER=groq
# BUILDR_AI_PROVIDER=groq
# GROQ_API_KEY=
# BUILDR_AI_EXTRACTION_MODEL=openai/gpt-oss-20b
# BUILDR_AI_SYNTHESIS_MODEL=openai/gpt-oss-120b
# BUILDR_AI_VERIFY_MODEL=openai/gpt-oss-120b
# BUILDR_AI_BUDGET_PROFILE=compact
# BUILDR_AI_TOKENS_PER_MINUTE=7500

# Rotate between several free tiers: each lane has its own models, budget
# and rate limits (config/buildr.php ai.lane_options); a lane that runs out
# hands the step to the next. Overrides the single-provider settings above.
# BUILDR_AI_LANES=gemini,groq
# GEMINI_API_KEY=
# BUILDR_AI_GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
# BUILDR_AI_GEMINI_SYNTHESIS_MODEL=gemini-3.5-flash
# BUILDR_AI_GEMINI_RPM=8

# Scraping (polite defaults: >= 2s between t.me requests across all workers)
BUILDR_SCRAPE_MIN_DELAY_MS=2000
BUILDR_SCRAPE_JITTER_MS=1500
BUILDR_SCRAPE_BACKFILL_MAX_POSTS=3000
BUILDR_SCRAPE_BACKFILL_MAX_MONTHS=36
BUILDR_CANARY_CHANNEL=telegram
BUILDR_SNAPSHOT_DISK=local

# Claims + content
BUILDR_CLAIM_CODE_PREFIX=BUILDR
BUILDR_CLAIM_CODE_TTL_HOURS=48
BUILDR_MAX_CHANNELS_PER_USER=5
BUILDR_MIN_TEXT_POSTS_FOR_PROFILE=20
BUILDR_REGEN_CREATOR_DAILY_LIMIT=3
BUILDR_DEFAULT_TIMEZONE=Africa/Addis_Ababa

# AI jobs can run for minutes; keep this above the 900s job timeout.
DB_QUEUE_RETRY_AFTER=960
REDIS_QUEUE_RETRY_AFTER=960

# Server-side rendering (run: php artisan inertia:start-ssr)
INERTIA_SSR_ENABLED=true
